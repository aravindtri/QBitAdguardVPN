#!/bin/bash
# Prepare AdGuard VPN persistence before the service starts.
# Do not call adguardvpn-cli here. config/status can overwrite the encrypted
# profile, and a second CLI process can log the user out.
echo "Setting up AdGuard VPN CLI persistence..."

# shellcheck disable=SC1091
. /usr/local/lib/adguard-persist.sh
adguard_prepare

echo "AdGuard VPN: profile store is /config/adguardvpn-cli"
echo "AdGuard VPN: HOME=$HOME"
if adguard_identity_ready; then
    echo "AdGuard VPN: interface MAC matches the saved identity."
else
    echo "AdGuard VPN: MAC does not match ./config/adguardvpn-identity/mac"
    echo "AdGuard VPN: the CLI will not start, so the saved login is left alone."
    echo "AdGuard VPN: set mac_address in docker-compose.yml to that value, then recreate the container."
fi

QBIT_CONF="/config/qBittorrent/qBittorrent.conf"
if [ -f "$QBIT_CONF" ]; then
    echo "Configuring qBittorrent to use tun0..."
    tmp="$(mktemp)"
    # Session\Interface lives under [BitTorrent]. Connection\Interface lives
    # under [Preferences]. A single sed against one section drops the other.
    awk '
        /^Session\\Interface=/ { next }
        /^Session\\InterfaceName=/ { next }
        /^Connection\\Interface=/ { next }
        /^Connection\\InterfaceName=/ { next }
        { print }
        /^\[BitTorrent\]$/ && !bt {
            print "Session\\Interface=tun0"
            print "Session\\InterfaceName=tun0"
            bt = 1
        }
        /^\[Preferences\]$/ && !pref {
            print "Connection\\Interface=tun0"
            print "Connection\\InterfaceName=tun0"
            pref = 1
        }
        END {
            if (!bt) {
                print ""
                print "[BitTorrent]"
                print "Session\\Interface=tun0"
                print "Session\\InterfaceName=tun0"
            }
            if (!pref) {
                print ""
                print "[Preferences]"
                print "Connection\\Interface=tun0"
                print "Connection\\InterfaceName=tun0"
            }
        }
    ' "$QBIT_CONF" > "$tmp"
    # Keep the existing inode so the abc user still owns the config.
    cat "$tmp" > "$QBIT_CONF"
    rm -f "$tmp"
fi

echo "AdGuard VPN setup complete."
